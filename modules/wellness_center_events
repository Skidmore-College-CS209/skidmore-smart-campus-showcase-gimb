class HashTable: #Our class for the date hashtable
    def __init__(self, startdate, size):
        self.dates = {}
        self.size = size
        startdate = datetime.strptime(startdate, '%Y/%m/%d')
        for i in range(size): #creates size keys/value pairs, incrementing based on the start date
            start = startdate.strftime('%Y/%m/%d')
            self.dates[start] = []
            startdate += timedelta(days=1)   
             
               
    def add(self, key, value): #adds an event based on day
        self.dates[key].append(value)


    def delete(self, key, value): #deletes an event based on day
        self.dates[key].remove(value)

    def get_keys(self): #returns all the dates
        keys = []
        for key in self.dates.keys():
            keys.append(key)
        return keys
    
    def get_index(self, key, event): #gets index of event in a list based on the date
        value = self.dates[key]
        index = value.index(event)
        return index
    
    def values(self):
        return self.dates.values()

    def edit(self, key, event, aspect, value): #user inputs the day of the event, the name of the event, what they want to change it to
        index = self.get_index(key, event)
        if aspect == 'name':
            self.dates[key][index].set_name(value)
        if aspect == 'date':
            self.delete(key, event)
            self.add(value, event)
            self.dates[value][index].set_date(value)
        if aspect == 'time':
            self.dates[key][index].set_time(value)
        if aspect == 'desc':
            self.dates[key][index].set_desc(value)
        if aspect == 'location':
            self.dates[key][index].set_location(value)


class Event: #our class structure for events 
    def __init__(self, name=None, category=None, date=None, time=None, desc=None, location=None):
        self.name = name
        self.category = category
        self.date = date
        self.time = time
        self.desc = desc
        self.location = location

    def get_name(self):
        return self.name
    
    def get_category(self):
        return self.category

    def set_name(self, name):
        self.name = name

    def get_date(self):
        return self.date

    def set_date(self, date):
        self.date = date

    def get_time(self):
        return self.time

    def set_time(self, time):
        self.time = time

    def get_desc(self):
        return self.desc

    def set_desc(self, desc):
        self.desc = desc

    def get_location(self):
        return self.location

    def set_location(self, location):
        self.location = location

