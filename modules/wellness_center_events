    def eventsfromlist(table, master): #compiles all the events from the table
        
        i = 0 #this section gets a count of every event, so it knows how many pages to make
        events = []

        for value in table.values():
            if value:
                for event in value:
                    events.append(event)
                    i += 1

        pages = math.ceil(i/3) #3 events per page
        count = 0
        pageframes = {}
        
        for page in range(pages): #makes 3 event frames per loop and adds them to one page

            pageframe = tk.Frame(master=master)
            eventframe = tk.Frame(master=pageframe)

            for event in events[count:count+3]:
                event_f = makeeventframe(event, table, eventframe, master)
                event_f.pack()
            
            eventframe.pack()

            pagenum = page + 1

            tk.Label(pageframe, text= f"Page {page+1}/{pages}").pack()
            if page < pages-1:
                tk.Button(pageframe, text="NEXT", command=lambda p = pagenum: show_page(p + 1, pageframes)).pack(side='right')
            if page > 0:
                tk.Button(pageframe, text="BACK", command=lambda p = pagenum: show_page(p - 1, pageframes)).pack(side='left')   

            
            page_name = f"page_{pagenum}"
            pageframes[page_name] = pageframe
            
            count += 3

        pageframes['page_1'].pack()




    def show_page(page, pageframes): #makes the current page invisible and the former or next page visible

        for frame in pageframes.values():
            frame.pack_forget()
            
        pageframes[f'page_{page}'].pack()
        



