    def run_search():
        query = search_entry.get().lower()
        words = re.findall(r'[a-z0-9]+', query)
        results = set()
        
        # Rebuild inverted index dynamically from current events
        inverted_index = defaultdict(set)
        for day_events in date_table.values():
            for event in day_events:
                text = f"{event.get_name()} {event.get_desc()} {event.get_location()}".lower()
                for word_in_text in re.findall(r'[a-z0-9]+', text):
                    inverted_index[word_in_text].add(event)
        
        for word in words:
            if word in inverted_index:
                results.update(inverted_index[word])
        
        display_results(list(results))

    
