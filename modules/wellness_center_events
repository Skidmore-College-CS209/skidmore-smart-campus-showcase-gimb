        for widget in results_frame.winfo_children():
            widget.destroy()
    
    search_button = tk.Button(search_frame, text= 'Search', command=run_search)
    search_button.pack(pady=5)

    search.bind('<Return>', lambda event: run_search()) 

    clear_button = tk.Button(student_window, text='Clear Search', command=clear_search)
    clear_button.pack(pady=5)

student_button = tk.Button(root, text='Student Access', command=student_access, anchor='center', cursor='hand2')
student_button.pack(pady=10)

admin_button = tk.Button(root, text='Admin Access', command=lambda: admin_access(date_table), anchor='center', cursor='hand2')
admin_button.pack(pady=5)

